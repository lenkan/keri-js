{
  "name": "keri",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenkan/keri-js.git",
    "directory": "packages/keri"
  },
  "type": "module",
  "author": "Daniel Lenksjö",
  "license": "Apache-2.0",
  "description": "KERI for JavaScript",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "deno": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "cesr": "workspace:*"
  }
}
