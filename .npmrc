# Deno Deploy's builder ships pnpm 10, which reads `packageManager` and tries to
# self-install pnpm 11 into ~/.local/share/pnpm/.tools. That install lands
# incomplete there and every pnpm command dies on a missing dist/pnpm.mjs, so
# both the install and build steps fail. Let the builder use the pnpm it has.
# `packageManager` still pins the version CI installs via pnpm/action-setup.
manage-package-manager-versions=false
