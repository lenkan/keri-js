{
  "name": "keri-js",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenkan/keri-js.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b packages/cesr/tsconfig.build.json packages/keri/tsconfig.build.json",
    "dev": "tsc -b packages/cesr/tsconfig.build.json packages/keri/tsconfig.build.json --watch",
    "pretest": "npm run build",
    "test": "node --test --no-warnings 'packages/*/src/**/*.test.ts'",
    "pretest:consumer": "npm run build",
    "test:consumer": "node --test --no-warnings 'test_consumer/**/*.test.ts'",
    "pretest:interop": "npm run build",
    "test:interop": "node --test --test-concurrency=1 --no-warnings 'test_interop/test_*.ts'",
    "pretest:vector": "npm run build",
    "test:vector": "node --test --no-warnings 'packages/cesr/test_vectors/**/*.test.ts'",
    "lint": "biome check . && node --no-warnings scripts/check-imports.ts",
    "lint:fix": "biome check --write . && node --no-warnings scripts/check-imports.ts",
    "precheck": "npm run build",
    "check": "tsc --noEmit && npm run check --workspaces --if-present",
    "clean": "node scripts/clean.ts",
    "format": "biome format --write .",
    "dev:verifier": "concurrently \"npm run dev\" \"npm run dev -w apps/verifier\"",
    "docs:build": "typedoc",
    "docs:serve": "concurrently \"serve api-docs\" \"typedoc --watch --preserveWatchOutput\""
  },
  "type": "module",
  "author": "Daniel Lenksjö",
  "license": "Apache-2.0",
  "description": "KERI for JavaScript",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/debug": "^4.1.13",
    "@types/node": "^22.15.30",
    "cesr": "*",
    "concurrently": "^9.2.1",
    "debug": "^4.4.3",
    "keri": "*",
    "serve": "^14.2.5",
    "typedoc": "^0.28.14",
    "typescript": "^6.0.2"
  }
}
