{
  "name": "keri-js",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenkan/keri-js.git"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "dev": "pnpm --filter \"./packages/*\" --parallel run dev",
    "pretest": "pnpm run build",
    "test": "node --test --no-warnings 'packages/*/src/**/*.test.ts'",
    "pretest:consumer": "pnpm run build",
    "test:consumer": "node --test --no-warnings 'test_consumer/**/*.test.ts'",
    "pretest:interop": "pnpm run build",
    "test:interop": "node --test --test-force-exit --test-concurrency=1 --no-warnings 'test_interop/test_*.ts'",
    "pretest:vector": "pnpm run build",
    "test:vector": "node --test --no-warnings 'packages/cesr/test_vectors/**/*.test.ts'",
    "lint": "biome check . && node --no-warnings scripts/check-imports.ts",
    "lint:fix": "biome check --write . && node --no-warnings scripts/check-imports.ts",
    "precheck": "pnpm run build",
    "check": "tsc --noEmit && pnpm --filter \"./packages/*\" --parallel run check",
    "clean": "node scripts/clean.ts",
    "format": "biome format --write .",
    "dev:verifier": "concurrently \"pnpm run dev\" \"pnpm --filter @keri-js/verifier run dev\""
  },
  "type": "module",
  "author": "Daniel Lenksjö",
  "license": "Apache-2.0",
  "description": "KERI for JavaScript",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^22.15.30",
    "cesr": "workspace:*",
    "concurrently": "^9.2.1",
    "debug": "^4.4.3",
    "keri": "workspace:*",
    "typescript": "^7.0.2"
  }
}
