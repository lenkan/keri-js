{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keri-verifier",
  // Pinned so a CI token with access to more than one account has no choice to
  // make. It is an identifier, not a credential.
  "account_id": "8935805b02bf9fe5b9968c3962159298",
  "main": "src/main.ts",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "../verifier/dist",
    "binding": "ASSETS",
    // `POST /` is the presentation endpoint KERIpy's sendDirect targets, and the
    // asset server's behaviour for non-GET methods is unspecified. Running the
    // worker first keeps the route table in one place, at the cost of an
    // invocation per asset request.
    "run_worker_first": true,
    // The worker falls back to the app shell itself, so that a missing asset
    // still answers 404 rather than a page of HTML. `html_handling` is off for
    // the same reason: its default redirects unmatched paths to `/` instead of
    // letting the worker decide.
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      // `wrangler dev` simulates the namespace locally and ignores this id.
      "id": "2be39371eb904495803b562216244296"
    }
  ],
  "observability": {
    "enabled": true,
    // A verifier this size will not generate enough traffic for sampling to
    // save anything, and a dropped trace is one presentation nobody can debug.
    "head_sampling_rate": 1
  }
}
