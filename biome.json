{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!**/dist",
      "!**/.wrangler",
      "!**/worker-configuration.d.ts",
      "!**/api-docs",
      "!**/.venv",
      "!**/docs",
      "!**/test-results",
      "!**/playwright-report"
    ]
  },
  "formatter": {
    "lineWidth": 120,
    "indentStyle": "space"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      },
      "style": {
        "noInferrableTypes": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["**/scripts/**/*.ts", "**/test_interop/**/*.ts", "**/test_utils/**/*.ts", "**/test_e2e/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
